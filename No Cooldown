local RunService = game:GetService("RunService")
local stepped = RunService.Stepped

-- Helper function to safely yield to the next frame and return valid timing data
local function fastYield()
    local deltaTime = stepped:Wait()
    return deltaTime, os.clock() -- Mimics standard Roblox return values
end

-- Hook legacy wait
if hookfunction and wait then
    hookfunction(wait, fastYield)
end

-- Hook modern task.wait
if hookfunction and task and task.wait then
    hookfunction(task.wait, fastYield)
end
