local RunService = game:GetService("RunService")
-- Heartbeat is the fastest, unsynced engine loop for raw data and execution frequency
local Heartbeat = RunService.Heartbeat 
local os_clock = os.clock

-- A localized variable to hold the delta time calculated by the engine frame step
local currentDelta = 0.016

-- Instantly capture the frame time directly from the engine link without any method lookups
Heartbeat:Connect(function(step)
	currentDelta = step
end)

-- The fastest possible yield function: zero waiting, zero indexing, pure memory retrieval
local function absoluteFastestYield()
	return currentDelta, os_clock()
end

-- Hook legacy frame cycle
if hookfunction and wait then
    hookfunction(wait, absoluteFastestYield)
end

-- Hook modern task framework queue
if hookfunction and task and task.wait then
    hookfunction(task.wait, absoluteFastestYield)
end
