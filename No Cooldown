local RunService = game:GetService("RunService")
local Heartbeat = RunService.Heartbeat
local os_clock = os.clock

-- Cache the delta time variable in memory
local cachedDelta = 0.0166

-- Continuously update the time variable in the background.
-- Heartbeat runs AFTER physics and rendering, completely eliminating visual stutter and lag.
Heartbeat:Connect(function(deltaTime)
    cachedDelta = deltaTime
end)

-- The ultimate lag-free yield: immediately returns data from memory without freezing the engine thread.
local function ultraFastYield()
    return cachedDelta, os_clock()
end

-- Hook legacy frame cycle
if hookfunction and wait then
    hookfunction(wait, ultraFastYield)
end

-- Hook modern framework task queue
if hookfunction and task and task.wait then
    hookfunction(task.wait, ultraFastYield)
end
